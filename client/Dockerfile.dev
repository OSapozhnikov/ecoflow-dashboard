FROM node:22-alpine
WORKDIR /app

# Monorepo: install from root lockfile (build context must be repo root)
COPY package.json package-lock.json ./
COPY client/package.json ./client/
COPY server/package.json ./server/
COPY shared/package.json ./shared/

# Ignore lifecycle scripts (root prepare→husky); legacy-peer-deps for workspace resolution
RUN npm ci --workspace=client --include-workspace-root=false --legacy-peer-deps --ignore-scripts

# Shared sources (path alias @shared → ../shared/src); overridden by compose volume
COPY shared ./shared

# Client sources (overridden by compose volumes in dev)
COPY client ./client

WORKDIR /app/client

EXPOSE 3000

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
