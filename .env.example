# ============================================
# Ecoflow Monitor - Environment Variables
# ============================================
# Copy this file to .env and fill in the values
# cp .env.example .env

# ============================================
# REQUIRED - Ecoflow API Credentials
# ============================================
# Get these keys from: https://developer-eu.ecoflow.com
ECOFLOW_ACCESS_KEY=your_access_key_here
ECOFLOW_SECRET_KEY=your_secret_key_here

# Ecoflow API Base URL
# For EU: https://api-eu.ecoflow.com
# For other regions: https://api-e.ecoflow.com
ECOFLOW_API_BASE_URL=https://api-e.ecoflow.com

# ============================================
# Server Configuration
# ============================================
PORT=5000
NODE_ENV=development

# Persistent data directory (SQLite history, settings.json, locations.json, contracts)
# Default: ./data  |  Docker: /app/data
DATA_DIR=./data

# ============================================
# Rate limiting (Express /api) — LAN / Docker friendly
# ============================================
# Behind Nginx all traffic looks like one Docker IP unless TRUST_PROXY is set.
# Private/loopback IPs are skipped by default (home-lab).
# TRUST_PROXY=1
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_SKIP_PRIVATE=true
# RATE_LIMIT_MAX=2000
# RATE_LIMIT_WINDOW_MS=900000

# ============================================
# CORS Configuration
# ============================================
# Frontend application URL for CORS
CORS_ORIGIN=http://localhost:3000

# ============================================
# MQTT Configuration (Optional)
# ============================================
# Enable MQTT for real-time updates
# MQTT credentials are automatically obtained via API endpoint /iot-open/sign/certification
# No need to manually configure MQTT username/password
ECOFLOW_MQTT_ENABLED=true

# MQTT Client ID (optional, auto-generated if not specified)
ECOFLOW_MQTT_CLIENT_ID=

# ============================================
# WebSocket Configuration (Optional)
# ============================================
# Enable WebSocket server for real-time updates
WEBSOCKET_ENABLED=true

# WebSocket path
WEBSOCKET_PATH=/ws

# ============================================
# Frontend Configuration (optional override)
# ============================================
# Default: empty / same-origin (Vite proxies /api and /ws in dev; Nginx in prod).
# Set only when the API is on another origin, e.g. local Vite without proxy:
# VITE_API_BASE_URL=http://localhost:5000
# Dev Docker Compose may also set VITE_API_BASE_URL_DOCKER=http://server:5000
# VITE_API_BASE_URL=